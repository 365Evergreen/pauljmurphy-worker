{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "pauljmurphy",
	"compatibility_date": "2026-08-14",
	"main": "src/worker.ts",
	"assets": {
		"not_found_handling": "single-page-application"
	},
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "pauljmurphy-website"
		}
	],
	"d1_databases": [

		{
			"binding": "pauljmurphy_website_db",
			"database_name": "pauljmurphy-website-db",
			"database_id": "3bdd490e-c502-4cbb-8b88-9a21c2f830ec",
			"remote": true
		}
	]
}